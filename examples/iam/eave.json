{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EaveWritesItsOwnHost",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::my-eaves-bucket/eaveswatch/*/host=web-3/*"
    },
    {
      "Sid": "EaveListsItsAsks",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-eaves-bucket",
      "Condition": {"StringLike": {"s3:prefix": "eaveswatch/env=*/kind=requests/*"}}
    },
    {
      "Sid": "EaveReadsItsAsks",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=requests/*/host=web-3/*"
    }
  ]
}
