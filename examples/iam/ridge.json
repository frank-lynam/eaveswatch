{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RidgeListsWhatItSyncs",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-eaves-bucket",
      "Condition": {"StringLike": {"s3:prefix": [
        "eaveswatch/env=*/kind=packets/*", "eaveswatch/env=*/kind=inventory/*",
        "eaveswatch/env=*/kind=flows/*", "eaveswatch/env=*/kind=answers/*"]}}
    },
    {
      "Sid": "RidgeReadsWhatItSyncs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=packets/*",
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=inventory/*",
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=flows/*",
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=answers/*"]
    },
    {
      "Sid": "RidgeSendsAsksAndProbes",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=requests/*",
        "arn:aws:s3:::my-eaves-bucket/eaveswatch/env=*/kind=check/*"]
    }
  ]
}
