{
  "role": "eave",
  "env": "prod",
  "store": "s3://my-eaves-bucket/eaveswatch",
  "region": "us-east-1",
  "state_dir": "/var/lib/eaveswatch",
  "every": 60,
  "sources": [
    {"name": "nginx", "path": "/var/log/nginx/*.log"},
    {"name": "api", "path": "/srv/api/logs/*.log", "service": "api"},
    {"name": "journal", "journald": true, "units": ["sshd.service", "api.service"]}
  ],
  "services": {"api": {"dir": "/srv/api"}},
  "raw": ["nginx"],
  "redact": ["cust-[0-9]{6}"]
}
